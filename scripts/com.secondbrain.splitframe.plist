<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Splitframe daily operator: stages the follow-up drafts that are due, every morning at 07:30.
  Drafts only — it has no send path and test_splitframe_daily.test_no_send_capability keeps it
  that way. Alex reads and sends.

  Install:
    cp scripts/com.secondbrain.splitframe.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.secondbrain.splitframe.plist
  Stop:
    launchctl unload ~/Library/LaunchAgents/com.secondbrain.splitframe.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.secondbrain.splitframe</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd ~/second-brain &amp;&amp; set -a &amp;&amp; source ./.env &amp;&amp; set +a &amp;&amp; /Library/Frameworks/Python.framework/Versions/3.14/bin/python3 scripts/splitframe_daily.py</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>7</integer>
        <key>Minute</key><integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/alexhickey24/second-brain/scripts/splitframe_daily.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/alexhickey24/second-brain/scripts/splitframe_daily.launchd.log</string>
</dict>
</plist>
